# AMP controller / ADS URL. Include any reverse-proxy base path.
AMP_URL=https://amp.example.com/
AMP_USERNAME=mcp-agent
AMP_PASSWORD=change-me
# Alternative to password for AMP service/remembered-login token authentication.
# Paste the complete value AMP displays, including a username: prefix when present:
# AMP_LOGIN_TOKEN=

# Current AMP 2 uses Authorization: Bearer <session>. Set legacy only for old AMP.
AMP_AUTH_MODE=bearer
AMP_VERIFY_TLS=true
AMP_REQUEST_TIMEOUT_MS=15000
AMP_RETRY_COUNT=2
AMP_METADATA_CACHE_TTL_MS=300000
AMP_MAX_FILE_BYTES=1048576

# Layered mutation policy. All are false by default.
AMP_ALLOW_WRITES=false
AMP_ALLOW_DISRUPTIVE=false
AMP_ALLOW_DESTRUCTIVE=false
AMP_ALLOW_HOST_PRIVILEGED=false
AMP_ENABLE_GENERIC_API=true
AMP_GENERIC_API_ALLOW_WRITES=false

# Optional host-local ampinstmgr fallback.
AMP_ENABLE_CLI=false
# Defaults: /usr/bin/ampinstmgr on Linux; C:\Program Files\CubeCoders Limited\AMP\ampinstmgr.exe on Windows.
# Set only for a non-default installation:
# AMPINSTMGR_PATH=/custom/path/to/ampinstmgr
AMP_CLI_TIMEOUT_MS=60000

AMP_LOG_LEVEL=info
# Optional append-only JSONL audit destination (mode 0600 when created).
# AMP_AUDIT_LOG=/var/log/amp-mcp-audit.jsonl

# stdio (default), or stateless streamable HTTP.
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
# Comma-separated DNS-rebinding and browser Origin allowlists for remote HTTP.
# MCP_HTTP_ALLOWED_HOSTS=amp-mcp.example.com
# MCP_HTTP_ALLOWED_ORIGINS=https://client.example.com
# Required for all-interface HTTP unless MCP_HTTP_ALLOW_INSECURE_REMOTE=true.
# MCP_HTTP_BEARER_TOKEN=generate-a-long-random-value
MCP_HTTP_ALLOW_INSECURE_REMOTE=false
